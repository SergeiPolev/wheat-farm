{
  "mcpServers": {
    "csharp-analyzer": {
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "tools/CSharpAnalyzerMcp"
      ],
      "env": {
        "PROJECT_PATH": "./wheat-farm.sln"
      }
    },
    "blender": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ]
    }
  }
}